{:min-bb-version "1.13.225"
 :paths ["src" "test" "resources"]
 :deps {clogem/sdk {:local/root "../clogem-sdk"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str]
             [clojure.test :as t])

  test
  {:doc "Run clojure.test over test/**/*_test.clj. The SDK's fictional echo module joins the test classpath as a second registry fixture."
   :extra-paths ["../clogem-sdk/examples/echo/src" "../clogem-sdk/examples/echo/resources"]
   :task (let [files (if (fs/exists? "test") (fs/glob "test" "**_test.clj") [])
               ns-of (fn [f] (-> (str (fs/relativize "test" f))
                                 (str/replace (re-pattern "\\.clj$") "")
                                 (str/replace "/" ".")
                                 (str/replace "_" "-")
                                 symbol))
               nss (sort (map ns-of files))]
           (if (empty? nss)
             (println "test: no test namespaces found")
             (do (apply require nss)
                 (let [{:keys [fail error]} (apply t/run-tests nss)]
                   (when (pos? (+ fail error)) (System/exit 1))))))}

  lint
  {:doc "Fitness checks: headers, namespace ownership, module isolation, the pod only in clogem.hub.db.sqlite, no prints outside clogem.hub.log, manifests, home paths."
   :requires ([clogem.sdk.lint :as lint])
   :task (when-not (lint/lint! {:root "." :license :epl-2.0
                                :namespaces ["clogem.hub" "clogem.module.system" "clogem.module.media" "clogem.module.ui"]
                                :pod-namespaces ["clogem.hub.db.sqlite"]
                                :log-namespace "clogem.hub.log"
                                :no-print-prefixes ["clogem.hub" "clogem.module"]})
           (System/exit 1))}

  dev
  {:doc "Run the daemon in the foreground on 127.0.0.1 (port from config or CLOGEM_PORT) with an nREPL on a random loopback port; daemon.edn records both."
   :requires ([clogem.hub.daemon :as daemon])
   :task (daemon/-main "--nrepl")}

  daemon
  {:doc "Run the daemon in the foreground without an nREPL (what the systemd unit and the stdio proxy's autostart run). A second daemon exits 3."
   :requires ([clogem.hub.daemon :as daemon])
   :task (daemon/-main)}

  shim
  {:doc "The stdio MCP door: proxy newline-delimited JSON-RPC on stdin/stdout to the running daemon, starting it when none answers."
   :requires ([clogem.hub.mcp.stdio :as stdio])
   :task (stdio/-main)}

  token
  {:doc "Print the bearer token of a client from clients.edn (created with default clients when missing): bb token <client-id>, e.g. llm, gui, admin, stdio."
   :requires ([clogem.hub.auth :as auth] [clogem.hub.config :as config])
   :task (let [id (first *command-line-args*)
               path (config/clients-file (config/load-config))
               clients (auth/load-clients! path)]
           (if-let [t (and id (auth/client-token clients id))]
             (println t)
             (do (binding [*out* *err*]
                   (println (str "usage: bb token <client-id>; clients in " path ": "
                                 (str/join ", " (keys (:clients clients))))))
                 (System/exit 1))))}

  systemd:install
  {:doc "Write the systemd user unit for this checkout to ~/.config/systemd/user/clogem-hub.service and print the commands to enable it (never run here)."
   :requires ([clogem.hub.systemd :as systemd])
   :task (let [{:keys [next-steps]} (systemd/install!)]
           (doseq [line next-steps] (println line)))}

  guard:public
  {:doc "Leak guard: workspace denylist, home paths, tokens, private files. Tree and history; --staged scans the index only (pre-commit)."
   :requires ([clogem.sdk.guard :as guard])
   :task (let [staged? (boolean (some #{"--staged"} *command-line-args*))]
           (when-not (guard/guard! {:root "." :staged? staged? :history? (not staged?)})
             (System/exit 1)))}

  guard:message
  {:doc "Leak guard over a commit message file (commit-msg hook): bb guard:message <file>."
   :requires ([clogem.sdk.guard :as guard])
   :task (when-not (guard/guard-message! {:root "." :file (first *command-line-args*)})
           (System/exit 1))}

  hooks:install
  {:doc "Install pre-commit (guard:public --staged) and commit-msg (guard:message) hooks in git's hooks directory."
   :task (let [dir (-> (p/shell {:out :string} "git" "rev-parse" "--git-path" "hooks")
                       :out str/trim fs/path)
               write! (fn [name body]
                        (let [hook (fs/path dir name)]
                          (fs/create-dirs dir)
                          (spit (str hook) body)
                          (fs/set-posix-file-permissions hook "rwxr-xr-x")
                          (println (str "hooks:install: wrote " hook))))
               banner (str "#!/bin/sh\n"
                           "# Installed by `bb hooks:install`: blocks commits that would leak\n"
                           "# private names, home paths or tokens into this public repository.\n"
                           "cd \"$(git rev-parse --show-toplevel)\" || exit 1\n")]
           (write! "pre-commit" (str banner "exec bb guard:public --staged\n"))
           (write! "commit-msg" (str banner "exec bb guard:message \"$1\"\n")))}}}
