#
# systemd user unit for the Clogem hub: one daemon per OS user. Rendered by
# `bb systemd:install` ({{BB}} and {{HUB_DIR}} are filled in), which prints
# the enable commands and never runs them (enabling units is the owner's
# call). Linger (`loginctl enable-linger`) keeps the user manager alive
# without a login session; WSL idle shutdown is a .wslconfig matter.

[Unit]
Description=Clogem hub (local-first media daemon, one per user)
Documentation=https://github.com/EchoJustus/clogem-hub
After=default.target

[Service]
Type=simple
ExecStart={{BB}} --config {{HUB_DIR}}/bb.edn daemon
WorkingDirectory={{HUB_DIR}}
# a second instance exits 3 on purpose: do not restart it in a loop
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=2
# SIGTERM drains the writer and ends the listen streams before exit
KillSignal=SIGTERM
TimeoutStopSec=90
Environment=XDG_RUNTIME_DIR=%t
# stdout is empty by design; logs are one EDN map per line on stderr
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
